# Local development defaults (dev-only credentials, never reuse). Copy to .env to override.
QD_DATABASE_URL=postgresql+psycopg://querydoctor:querydoctor@127.0.0.1:5435/querydoctor_meta
QD_TARGET_DSN=postgresql://qd_readonly:qd_readonly@127.0.0.1:5433/querydoctor_sample
QD_BENCH_DSN=postgresql://qd_bench:qd_bench@127.0.0.1:5434/postgres
QD_REDIS_URL=redis://127.0.0.1:6379/0
# Fernet key for encrypting stored connection credentials: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QD_SECRET_KEY=
QD_MONGO_TARGET_URI=mongodb://qd_readonly:qd_readonly@127.0.0.1:27018/qd_sample?authSource=admin
QD_MONGO_BENCH_URI=mongodb://qd_bench:qd_bench@127.0.0.1:27018/?authSource=admin
